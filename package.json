{
  "name": "openmaps",
  "version": "1.0.0",
  "description": "Open source Google Maps alternative",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && npm run dev",
    "build": "tsc && vite build",
    "build:backend": "cd backend && npm run build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build:pwa": "npm run build && echo 'PWA build - requires workbox-cli: npm install -g workbox-cli && workbox generateSW'",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "build:electron": "npm run build && npm run build:backend && electron-builder",
    "build:electron-win": "npm run build && npm run build:backend && electron-builder --win",
    "build:tauri": "npm run build && echo 'Tauri build - requires: npm install --save-dev @tauri-apps/cli && cargo install tauri-cli'",
    "build:mobile": "npm run build && echo 'Mobile build - requires: npm install @capacitor/core @capacitor/cli @capacitor/ios @capacitor/android'",
    "build:docker": "docker build -f Dockerfile.standalone -t openmaps-standalone .",
    "build:all": "npm run build && echo 'Standard build complete. See DEPLOYMENT.md for standalone app builds.'"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "leaflet": "^1.9.4",
    "react-leaflet": "^4.2.1",
    "@types/leaflet": "^1.9.8",
    "lucide-react": "^0.263.1",
    "clsx": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.27",
    "electron": "^22.0.0",
    "electron-builder": "^24.0.0",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.openmaps.app",
    "productName": "OpenMaps",
    "directories": {
      "output": "release/OpenMaps-Desktop-v${version}"
    },
    "files": [
      "dist/**/*",
      "backend/dist/**/*",
      "backend/package.json",
      "electron/**/*",
      "public/icons/**/*"
    ],
    "extraFiles": [
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icons/icon-512.png",
      "publisherName": "OpenMaps Team"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "public/icons/icon-512.png",
      "category": "public.app-category.navigation"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icons/icon-512.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}