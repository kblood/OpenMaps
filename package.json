{
  "name": "openmaps",
  "version": "1.0.0",
  "description": "Open source Google Maps alternative",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && npm run dev",
    "build": "tsc && vite build",
    "build:backend": "cd backend && npm run build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build:pwa": "npm run build && echo 'PWA build - requires workbox-cli: npm install -g workbox-cli && workbox generateSW'",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "build:electron": "npm run build && npm run build:backend && electron-builder",
    "build:electron-win": "npm run build && npm run build:backend && electron-builder --win",
    "build:tauri": "npm run build && echo 'Tauri build - requires: npm install --save-dev @tauri-apps/cli && cargo install tauri-cli'",
    "build:mobile": "npm run build && echo 'Mobile build - requires: npm install @capacitor/core @capacitor/cli @capacitor/ios @capacitor/android'",
    "build:docker": "docker build -f Dockerfile.standalone -t openmaps-standalone .",
    "build:all": "npm run build && echo 'Standard build complete. See DEPLOYMENT.md for standalone app builds.'"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.8",
    "clsx": "^2.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "cross-env": "^7.0.3",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  },
  "build": {
    "appId": "com.openmaps.app",
    "productName": "OpenMaps",
    "copyright": "Copyright © 2025 OpenMaps Team",
    "buildVersion": "1.0.0",
    "directories": {
      "output": "release/OpenMaps-Desktop-v${version}"
    },
    "files": [
      "dist/**/*",
      "backend/dist/**/*",
      "backend/package.json",
      "electron/**/*",
      "public/icons/**/*",
      "!**/*.map",
      "!**/node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "public/icons",
        "to": "icons"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-256.png",
      "publisherName": "OpenMaps Team",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png",
      "category": "public.app-category.navigation",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png",
      "category": "Office",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenMaps",
      "installerIcon": "public/icons/icon-256.png",
      "uninstallerIcon": "public/icons/icon-256.png",
      "installerHeaderIcon": "public/icons/icon-256.png",
      "installerSidebar": null,
      "uninstallerSidebar": null,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "license": "LICENSE",
      "warningsAsErrors": false,
      "displayLanguageSelector": false,
      "installerLanguages": ["en_US"],
      "include": null
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "compression": "normal",
    "nodeGypRebuild": false,
    "npmRebuild": false
  }
}
